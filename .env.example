# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values for HIVE Intelligence RAG.
# Use a Supabase secret key where available; legacy service_role is also supported.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HIVE_ORGANISATION_ID=

# HIVE Intelligence model gateway.
HIVE_AI_PROVIDER=openai-compatible
HIVE_AI_BASE_URL=
HIVE_AI_API_KEY=
HIVE_AI_MODEL=

# Embeddings can use a separate approved endpoint or fall back to HIVE_AI_BASE_URL/API key.
# The current pgvector schema expects 384-dimensional embeddings.
HIVE_EMBEDDING_BASE_URL=
HIVE_EMBEDDING_API_KEY=
# Preferred current path: Supabase built-in gte-small Edge Function.
HIVE_SUPABASE_EMBEDDING_URL=
HIVE_SUPABASE_EMBEDDING_TOKEN=

# Optional alternative OpenAI-compatible embedding provider.
HIVE_EMBEDDING_MODEL=

# Local/demo fallback only. Set false when a live provider is configured.
HIVE_AI_ALLOW_MOCK=true
